# Real API mode is the default. Use true only for isolated frontend demonstrations.
VITE_USE_MOCK_API=false

# Optional. Defaults to /api locally and /helpdesk/api in production builds.
# VITE_API_BASE_URL=/api

# Local Vite proxy target. The browser still requests same-origin /api URLs.
VITE_BACKEND_ORIGIN=http://127.0.0.1:5050

# Optional overrides for the backend development seed users.
# VITE_DEV_STUDENT_ID=10000000-0000-4000-8000-000000000001
# VITE_DEV_FACULTY_ID=10000000-0000-4000-8000-000000000002
